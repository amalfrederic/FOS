# FoodieHub Backend Environment Configuration
PROJECT_NAME="FoodieHub"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql+psycopg://foodiehub:foodiehub_password@localhost:5432/foodiehub_dev"
TEST_DATABASE_URL="postgresql+psycopg://foodiehub:foodiehub_password@localhost:5432/foodiehub_test"

# Business Rules
DELIVERY_FEE=40.0
FREE_DELIVERY_THRESHOLD=500.0
TAX_RATE=0.05
MAX_ITEM_QUANTITY=50
MIN_ITEM_QUANTITY=1
